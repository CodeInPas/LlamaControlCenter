  object dlgOpenModel: TOpenDialog
    Title = 'Select Target GGUF Model File'
    Filter = 'GGUF Models (*.gguf)|*.gguf|All Files (*.*)|*.*'
    Left = 704
    Top = 24
  end
  object dlgSaveCSV: TSaveDialog
    Title = 'Export Benchmark Results to CSV'
    DefaultExt = '.csv'
    Filter = 'CSV Spreadsheet (*.csv)|*.csv|Text Files (*.txt)|*.txt|All Files (*.*)|*.*'
    Options = [ofOverwritePrompt, ofEnableSizing, ofViewDetail]
    Left = 776
    Top = 24
  end
