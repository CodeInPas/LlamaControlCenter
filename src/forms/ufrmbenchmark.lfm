            end          
            item
              Caption = 'Gen (TG)'
              Width = 80
            end          
            item
              Caption = 'TG Speed (t/s)'
              Width = 110
            end          
            item
              Caption = 'Details'
              Width = 100
            end>
          GridLines = True
          ReadOnly = True
          RowSelect = True
          TabOrder = 0
          ViewStyle = vsReport
        end
      end
