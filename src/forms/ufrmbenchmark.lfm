    object pgcResults: TPageControl
      Left = 8
      Height = 223
      Top = 8
      Width = 944
      ActivePage = tsTable
      Align = alClient
      BorderSpacing.Around = 8
      TabIndex = 0
      TabOrder = 0
      object tsTable: TTabSheet
        Caption = 'Benchmark Results Table'
        ClientHeight = 195
        ClientWidth = 936
        object lvResults: TListView
          Left = 0
          Height = 195
          Top = 0
          Width = 936
          Align = alClient
          Columns = <          
            item
              Caption = 'Model / Arch'
              Width = 150
            end          
            item
              Caption = 'Params'
              Width = 70
            end          
            item
              Caption = 'Backend'
              Width = 80
            end          
            item
              Caption = 'Threads'
              Width = 65
            end          
            item
              Caption = 'NGL'
              Width = 55
            end          
            item
              Caption = 'Prompt (PP)'
              Width = 90
            end          
            item
