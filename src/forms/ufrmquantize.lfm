      object lblQuantType: TLabel
        Left = 12
        Height = 15
        Top = 6
        Width = 107
        Caption = 'Quantization Target:'
        ParentColor = False
      end
      object cmbQuantType: TComboBox
        Left = 12
        Height = 23
        Top = 24
        Width = 190
        ItemHeight = 15
        ItemIndex = 0
        Items.Strings = (
          'Q4_K_M (Recommended Balanced)'
          'Q5_K_M (High Quality 5-bit)'
          'Q8_0 (Near Lossless 8-bit)'
          'Q6_K (High Quality 6-bit)'
          'Q4_K_S (Compact 4-bit)'
          'Q5_K_S (Compact 5-bit)'
          'Q3_K_M (Medium 3-bit)'
          'Q3_K_S (Small 3-bit)'
          'Q2_K (Extreme 2-bit)'
          'IQ4_NL (Importance Matrix 4-bit)'
          'IQ4_XS (Extra Small 4-bit)'
          'IQ3_M (High Quality 3-bit IQ)'
          'IQ3_S (Small 3-bit IQ)'
          'IQ2_M (Medium 2-bit IQ)'
          'IQ2_S (Small 2-bit IQ)'
          'IQ1_S (1.5-bit Ultra Compact)'
          'Q4_0 (Standard Legacy)'
          'Q4_1 (Legacy)'
          'Q5_0 (Standard Legacy)'
          'Q5_1 (Legacy)'
        )
        Style = csDropDownList
        TabOrder = 0
        Text = 'Q4_K_M (Recommended Balanced)'
        OnChange = cmbQuantTypeChange
      end
      object lblThreads: TLabel
        Left = 216
